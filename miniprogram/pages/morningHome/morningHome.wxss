.page { min-height: 100vh; padding: 0 30rpx 80rpx; box-sizing: border-box; overflow: hidden; position: relative; background: linear-gradient(180deg, #ffe8f1 0%, #fff8fb 45%, #ffffff 100%); }
.sky { height: 230rpx; position: relative; }
.sun { position: absolute; width: 116rpx; height: 116rpx; border-radius: 50%; right: 56rpx; top: 46rpx; background: linear-gradient(145deg, #ffd7e6, #ff9fc1); box-shadow: 0 0 0 22rpx rgba(255, 155, 195, .16), 0 18rpx 54rpx rgba(255, 122, 171, .22); }
.cloud { position: absolute; height: 30rpx; border-radius: 99rpx; background: rgba(255, 255, 255, .78); }
.cloud::before, .cloud::after { content: ""; position: absolute; border-radius: 50%; background: inherit; }
.cloud::before { width: 48rpx; height: 48rpx; left: 24rpx; bottom: 0; }
.cloud::after { width: 68rpx; height: 68rpx; left: 58rpx; bottom: 0; }
.cloud-one { width: 152rpx; top: 118rpx; left: 16rpx; }
.cloud-two { width: 120rpx; top: 180rpx; right: 2rpx; opacity: .6; transform: scale(.75); }
.loading { padding-top: 180rpx; text-align: center; color: #c3839b; }
.load-error-card { margin: 34rpx 4rpx 0; padding: 52rpx 34rpx; border-radius: 34rpx; background: rgba(255, 255, 255, .9); box-shadow: 0 16rpx 46rpx rgba(164, 77, 112, .09); text-align: center; }
.load-error-title { display: block; color: #5b3544; font-size: 34rpx; font-weight: 700; }
.load-error-text { display: block; margin-top: 16rpx; color: #a87389; font-size: 25rpx; line-height: 1.6; }
.load-retry-btn { width: 280rpx; margin: 30rpx auto 0; border-radius: 999rpx; background: linear-gradient(145deg, #ff8fb8, #ffb8d1); color: #fff; font-size: 26rpx; font-weight: 650; }
.hero { padding: 0 18rpx 38rpx; display: flex; flex-direction: column; }
.date { font-size: 23rpx; color: #c7839d; letter-spacing: 2rpx; }
.greeting { margin-top: 14rpx; font-size: 52rpx; color: #5b3544; font-weight: 700; }
.weather-line { margin-top: 24rpx; font-size: 34rpx; color: #7a4a5c; }
.weather-note { margin-top: 10rpx; font-size: 25rpx; color: #b27b90; }
.advice-card, .love-card, .days-card, .care-card, .comfort-card, .meeting-card, .memory-card { margin-bottom: 24rpx; border-radius: 34rpx; box-shadow: 0 16rpx 46rpx rgba(164, 77, 112, .09); }
.advice-card { padding: 34rpx; background: rgba(255, 255, 255, .88); }
.mini-title { color: #d878a0; font-size: 19rpx; letter-spacing: 4rpx; }
.advice { display: block; margin-top: 14rpx; color: #5a3444; font-size: 34rpx; font-weight: 650; }
.divider { height: 1px; margin: 26rpx 0 20rpx; background: #f7dce7; }
.small-note { color: #aa7b8d; font-size: 24rpx; }
.love-card { padding: 36rpx 38rpx; position: relative; overflow: hidden; background: linear-gradient(145deg, #ff8fb8, #ffc1d7); color: #fff; }
.quote { position: absolute; right: 28rpx; top: -28rpx; font-size: 150rpx; opacity: .16; font-family: serif; }
.love-text { display: block; max-width: 570rpx; font-size: 31rpx; line-height: 1.75; font-weight: 520; }
.signature { display: block; margin-top: 22rpx; font-size: 22rpx; opacity: .78; letter-spacing: 2rpx; }
.days-card { display: flex; align-items: center; padding: 28rpx 32rpx; background: linear-gradient(145deg, #fff, #fff0f6); color: #5b3544; border: 2rpx solid rgba(255, 195, 216, .75); }
.days-number { min-width: 116rpx; font-size: 56rpx; color: #ff80ad; font-weight: 700; }
.days-copy { margin-left: 20rpx; display: flex; flex-direction: column; }
.days-title { font-size: 28rpx; }
.days-love { margin-top: 8rpx; color: #ff80ad; font-size: 27rpx; font-weight: 650; }
.days-sub { margin-top: 8rpx; font-size: 22rpx; color: #b2758e; }
.care-card, .comfort-card, .meeting-card, .memory-card { padding: 34rpx; background: rgba(255, 255, 255, .93); border: 1rpx solid rgba(255, 213, 228, .72); }
.card-title { display: block; color: #5b3544; font-size: 30rpx; font-weight: 700; }
.card-row { display: flex; align-items: center; justify-content: space-between; }
.card-link { color: #d878a0; font-size: 24rpx; }
.care-item { margin-top: 20rpx; display: flex; align-items: flex-start; }
.care-dot { width: 12rpx; height: 12rpx; margin-top: 13rpx; margin-right: 16rpx; border-radius: 50%; background: #ff9fc1; flex-shrink: 0; }
.care-text { color: #704b5b; font-size: 27rpx; line-height: 1.45; }
.soft-btn { margin-top: 26rpx; padding: 22rpx 24rpx; border-radius: 999rpx; background: linear-gradient(145deg, #ff8fb8, #ffb8d1); color: #fff; text-align: center; font-size: 26rpx; font-weight: 650; }
.comfort-text { display: block; margin-top: 20rpx; color: #704b5b; font-size: 29rpx; line-height: 1.65; }
.meeting-main { display: block; margin-top: 20rpx; color: #5b3544; font-size: 36rpx; font-weight: 700; }
.meeting-sub, .meeting-wish { display: block; margin-top: 10rpx; color: #a87389; font-size: 25rpx; line-height: 1.55; }
.memory-card { background: linear-gradient(145deg, #fff, #fff5f9); }
.memory-text { display: block; margin-top: 22rpx; color: #704b5b; font-size: 29rpx; line-height: 1.65; }
.little-card { margin: 26rpx 0 0; padding: 28rpx 30rpx; display: flex; align-items: center; justify-content: space-between; border-radius: 32rpx; background: linear-gradient(135deg, #fff7fb 0%, #ffe4ef 56%, #ffd3e4 100%); border: 2rpx solid rgba(255, 153, 193, .58); box-shadow: 0 16rpx 42rpx rgba(204, 91, 135, .14); }
.little-copy { display: flex; flex-direction: column; max-width: 430rpx; }
.little-kicker { color: #d878a0; font-size: 18rpx; letter-spacing: 5rpx; font-weight: 700; }
.little-title { margin-top: 8rpx; color: #5b3544; font-size: 33rpx; font-weight: 800; }
.little-desc { margin-top: 8rpx; color: #a96f86; font-size: 24rpx; line-height: 1.45; }
.little-action { min-width: 150rpx; height: 58rpx; padding: 0 18rpx 0 24rpx; display: flex; align-items: center; justify-content: center; border-radius: 999rpx; background: #ff8fb8; color: #fff; font-size: 24rpx; font-weight: 700; box-shadow: 0 10rpx 24rpx rgba(255, 128, 173, .26); }
.little-arrow { margin-left: 8rpx; font-size: 34rpx; line-height: 1; }
.subscribe-note, .preview-note { display: block; margin-top: 16rpx; text-align: center; color: #b8849a; font-size: 22rpx; }
.content-editor-link { margin-top: 22rpx; padding: 20rpx 28rpx; display: flex; align-items: center; justify-content: space-between; border-radius: 24rpx; background: rgba(255, 255, 255, .72); border: 1rpx solid rgba(255, 173, 205, .7); color: #bd6687; font-size: 25rpx; font-weight: 650; }
.content-editor-arrow { color: #ff7fac; font-size: 36rpx; line-height: 1; }
