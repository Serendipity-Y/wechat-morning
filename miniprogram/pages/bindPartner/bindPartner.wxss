.page { min-height: 100vh; padding: 120rpx 58rpx 60rpx; box-sizing: border-box; display: flex; flex-direction: column; align-items: center; background: radial-gradient(circle at 80% 0%, #ffe1d6 0, transparent 38%), #fffaf6; }
.heart { width: 112rpx; height: 112rpx; border-radius: 40rpx; display: flex; align-items: center; justify-content: center; background: #ff8067; color: #fff; font-size: 72rpx; box-shadow: 0 18rpx 46rpx rgba(255, 128, 103, .24); }
.title { margin-top: 52rpx; font-size: 40rpx; font-weight: 700; color: #3f302c; text-align: center; }
.desc { margin-top: 24rpx; color: #8a7068; font-size: 27rpx; line-height: 1.8; text-align: center; }
.code { width: 100%; height: 112rpx; margin-top: 68rpx; border-radius: 24rpx; background: #fff; border: 2rpx solid #f1d9d0; text-align: center; font-size: 52rpx; letter-spacing: 24rpx; color: #4f3933; box-shadow: 0 12rpx 36rpx rgba(98, 68, 58, .07); }
.button { width: 100%; margin-top: 28rpx; padding: 30rpx 0; border-radius: 24rpx; background: #493a35; color: #fff; text-align: center; font-size: 30rpx; }
.disabled { opacity: .55; }
.privacy { margin-top: 30rpx; color: #b29b93; font-size: 23rpx; }
